# Supabase project credentials.
# Find these under Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses Row Level Security, so never expose this to the browser
# and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Enables the weather panel on the dashboard.
NEXT_PUBLIC_OPENWEATHER_API_KEY=your-openweather-key

# Password used by the one-click demo sign-in buttons on the login page.
# Leave unset to hide those buttons and require manual sign-in.
NEXT_PUBLIC_DEMO_PASSWORD=
